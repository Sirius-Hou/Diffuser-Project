{
  "name": "probe_b2",
  "description": "R2 test: at B2's first trigger, sample 16 plans and count how many already avoid the obstacle without the maze map.",
  "env": "maze2d-large-v1",
  "diffusion_loadpath": "diffusion/H384_T256",
  "diffusion_epoch": "latest",
  "device": "cuda",
  "torch_threads": 8,
  "success_radius": 0.5,
  "max_steps": 800,
  "collision_margin": 0.05,
  "scenarios": "experiments/blocked/scenarios/scenarios_v1.json",
  "kinds": [
    "full"
  ],
  "probe": {
    "n": 16,
    "k": 10,
    "limit": 20,
    "horizons": [
      "full",
      "deadline",
      "euclid"
    ],
    "time_n": [
      1,
      4,
      16
    ]
  },
  "out": "experiments/blocked/results/probe_b2",
  "method_params": {
    "common": {
      "steps_per_cell": 30,
      "h_margin": 32,
      "h_min": 64,
      "deadline_slack": 40
    }
  },
  "max_wall_depth": 0.2
}