{
  "name": "blocked_probe_multigoal_lag",
  "description": "probe_multigoal_junctions plus lag_trigger 1.0 (one cell): a ball more than one cell behind its plan to the goal is handed to the A* legs. Ours only.",
  "env": "maze2d-large-v1",
  "diffusion_loadpath": "diffusion/H384_T256",
  "diffusion_epoch": "latest",
  "device": "cuda",
  "torch_threads": 0,
  "success_radius": 0.5,
  "scenarios": {
    "seed_start": 0,
    "max_seeds": 150,
    "n_full": 16,
    "n_partial": 0,
    "t_appear": [
      60,
      100,
      140
    ],
    "min_ahead_cells": 2,
    "partial_frac": 0.5,
    "random_goal": true,
    "min_goal_cells": 8
  },
  "n_samples": 16,
  "k": 10,
  "k_fixed": 100,
  "max_triggers": 5,
  "check_margin": 0.05,
  "replan_horizon": "remaining",
  "budget_slack_steps": 40,
  "steps_per_cell": 32,
  "min_horizon": 32,
  "max_leg_cells": null,
  "waypoint_radius": 0.5,
  "leg_grace_steps": 20,
  "replan_seed_offset": 500000,
  "oracle_kp": 5.0,
  "oracle_vmax": 3.0,
  "oracle_kv": 1.0,
  "waypoint_mode": "junctions",
  "n_samples_leg": 8,
  "leg_start_at_rest": true,
  "save_png": true,
  "out": "experiments/blocked/results/probe_multigoal_lag",
  "lag_trigger": 1.0
}
