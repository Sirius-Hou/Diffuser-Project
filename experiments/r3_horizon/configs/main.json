{
  "name": "r3_main",
  "description": "Horizon sweep for short legs (R3) and batch timing (R5).",
  "env": "maze2d-large-v1",
  "diffusion_loadpath": "diffusion/H384_T256",
  "diffusion_epoch": "latest",
  "device": "cuda",
  "torch_threads": 0,
  "seed": 0,
  "distances": [1, 2, 3, 4, 6, 8, 10],
  "pairs_per_distance": 4,
  "horizons": [32, 48, 64, 96, 128, 192, 256, 384],
  "n_samples": 4,
  "slack_steps": 40,
  "success_radius": 0.5,
  "waypoint_radius": 0.3,
  "min_rate": 0.9,
  "timing": {"horizons": [64, 128, 384], "batch_sizes": [1, 4, 8, 16], "repeats": 3},
  "out": "experiments/r3_horizon/results/main"
}
