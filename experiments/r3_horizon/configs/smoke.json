{
  "name": "r3_smoke",
  "description": "Tiny run: checks that a short horizon samples and executes at all.",
  "env": "maze2d-large-v1",
  "diffusion_loadpath": "diffusion/H384_T256",
  "diffusion_epoch": "latest",
  "device": "cuda",
  "torch_threads": 0,
  "seed": 0,
  "distances": [2, 6],
  "pairs_per_distance": 1,
  "horizons": [64, 384],
  "n_samples": 2,
  "slack_steps": 40,
  "success_radius": 0.5,
  "waypoint_radius": 0.3,
  "min_rate": 0.9,
  "timing": {"horizons": [64, 384], "batch_sizes": [1, 4], "repeats": 1},
  "out": "experiments/r3_horizon/results/smoke"
}
